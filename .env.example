# Database
# Host port is mapped to 5433 (not 5432) in docker-compose.yml to avoid clashing
# with other local Postgres instances. Containers talk to each other over the
# internal network using "postgres:5432" (see docker-compose.yml).
DATABASE_URL=postgres://applyforge:applyforge@localhost:5433/applyforge?sslmode=disable

# Service URLs
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
AI_WORKER_URL=http://localhost:8000

# AI provider (Phase 4+)
# Set OPENAI_API_KEY in your local .env (gitignored) or export it in the shell
# before docker compose up. Compose injects it into the AI worker; merely
# storing a key elsewhere in Docker does not make it available automatically.
# The key enables real OpenAI-backed resume parsing, JD parsing, and tailoring (apps/ai-worker/app/providers/openai_provider.py). Falls back
# automatically to deterministic heuristics if unset, rate-limited, or down —
# see docs/AI_PIPELINE.md and docs/DECISIONS.md.
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
AI_API_KEY=
OPENAI_API_KEY=
# Default/high-volume model. Current OpenAI guidance favors GPT-5.6 Luna for
# cost-sensitive workloads. High-value resume operations can override it below.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_RESUME_MODEL=gpt-5.6-terra
OPENAI_TAILORING_MODEL=gpt-5.6-sol
OPENAI_RANKING_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# The Go API delegates embeddings to the AI worker. Keep true for the local
# MVP even though the API container itself does not need OPENAI_API_KEY.
AI_EMBEDDINGS_ENABLED=true

# Object storage (S3-compatible: Cloudflare R2 / AWS S3) (Phase 2+)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false

# Auth (Phase 1+)
AUTH_SECRET=
AUTH_PROVIDER_KEYS=

# Google OAuth (Phase 1+). Leave blank to disable "Continue with Google" in local dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Observability
LOG_LEVEL=info
ENVIRONMENT=development

# Go API process
API_ADDR=:8080

# Optional manual global job-source sync route. When empty, the route is not mounted.
ADMIN_SYNC_TOKEN=

# Free local sponsor source bootstrap.
# Enabled by default outside production. ApplyForge reads public MIT-licensed
# ATS company inventories and exact-matches the 10,000-company H-1B sponsor
# watchlist. Direct Greenhouse/Lever/Ashby/Workday/Workable matches are polled
# by sponsor tier: HOT hourly, WARM every 4 hours, COOL every 8 hours, COLD
# daily. Other portals remain registry-only for inspection/future connectors.
# No API key is required.
FREE_SPONSOR_SOURCE_BOOTSTRAP_ENABLED=true
# Backward-compatible legacy flag; the new flag above takes precedence.
FREE_HOT_SOURCE_BOOTSTRAP_ENABLED=true

# Sponsor-watchlist company source discovery.
# When enabled, ApplyForge searches Google Organic through DataForSEO for the
# careers/ATS endpoint of unresolved H-1B sponsor companies, then promotes
# Greenhouse/Lever/Ashby/SmartRecruiters/Workable boards to direct polling.
# Credentials are DataForSEO API credentials; never commit real values.
#
# Defaults bootstrap up to 10,000 companies using 10-result Live Organic
# requests. The request limits are hard safety caps enforced in PostgreSQL.
# The estimated USD value is accounting metadata only because provider pricing
# can change; keep it aligned with your current DataForSEO plan.
DATAFORSEO_SOURCE_DISCOVERY_ENABLED=false
DATAFORSEO_API_LOGIN=
DATAFORSEO_API_PASSWORD=
DATAFORSEO_ORGANIC_LIVE_URL=https://api.dataforseo.com/v3/serp/google/organic/live/advanced
DATAFORSEO_SOURCE_DISCOVERY_DEPTH=10
DATAFORSEO_SOURCE_DISCOVERY_BATCH_SIZE=500
DATAFORSEO_SOURCE_DISCOVERY_INTERVAL_MINUTES=15
DATAFORSEO_SOURCE_DISCOVERY_MAX_REQUESTS_PER_DAY=10000
DATAFORSEO_SOURCE_DISCOVERY_MAX_REQUESTS_PER_MONTH=10000
DATAFORSEO_SOURCE_DISCOVERY_ESTIMATED_USD_PER_REQUEST=0.002

# Optional structured career-page inspection.
# This makes bounded public HTTP requests to registry-only career URLs and
# looks for known ATS links plus schema.org JobPosting JSON-LD. Outbound
# requests use an SSRF-safe client that rejects private/link-local networks.
# Keep disabled until you are ready to crawl the discovered career URLs.
CAREER_PAGE_INSPECTION_ENABLED=false
CAREER_PAGE_INSPECTION_BATCH_SIZE=100
CAREER_PAGE_INSPECTION_INTERVAL_MINUTES=30

# Direct Workday CXS polling. The exact tenant/site is discovered from public
# Workday career/job URLs; no Workday credentials are required.
# Listing enumeration is complete, while expensive detail calls are limited to
# recent postings. Existing older rows are still touched through full snapshot IDs.
WORKDAY_MAX_JOBS_PER_POLL=10000
WORKDAY_DETAIL_MAX_AGE_DAYS=7

# Primary broad U.S. jobs discovery provider.
# `linkedin_keyword` uses Bright Data's public LinkedIn "Discover new jobs by
# keyword" scraper. One daily core shard distributes the configured record cap
# across Java, Go, backend, full-stack, frontend, platform, DevOps, SRE, cloud,
# and general software searches instead of letting one generic query consume
# the whole response.
#
# The default 140-record daily budget is split across 12 keyword inputs. With
# integer allocation this requests at most 132 successful records/day, or 4,092
# in a 31-day month, leaving room under a 5,000-record monthly free allowance
# for manual testing. Provider pricing/allowances can change; verify your plan.
BRIGHTDATA_ENABLED=false
BRIGHTDATA_API_KEY=
BRIGHTDATA_MODE=linkedin_keyword
# Bright Data's current fixed dataset for LinkedIn discover-by-keyword. Override
# only if Bright Data changes the dataset id.
BRIGHTDATA_LINKEDIN_KEYWORD_DATASET_ID=gd_lpfll7v5hcqtkxl6l
BRIGHTDATA_JOBS_RECORDS_LIMIT=140
BRIGHTDATA_ACTIVE_SHARDS=us-single-user-core-24h
BRIGHTDATA_POLL_INTERVAL_MINUTES=1440
BRIGHTDATA_JOBS_COUNTRY_VALUE=US

# Legacy compatibility mode. Set BRIGHTDATA_MODE=marketplace_filter to use a
# pre-collected Marketplace Jobs dataset, then provide its dataset id and field
# names below. These values are ignored by linkedin_keyword mode except country.
BRIGHTDATA_JOBS_DATASET_ID=
BRIGHTDATA_JOBS_TITLE_FIELD=job_title
BRIGHTDATA_JOBS_POSTED_DATE_FIELD=posted_date
BRIGHTDATA_JOBS_COUNTRY_FIELD=country_code

# Optional AI cost accounting. Keep these aligned with the models configured
# above; leaving them blank records real token counts but NULL estimated cost.
OPENAI_INPUT_USD_PER_1M_TOKENS=
OPENAI_OUTPUT_USD_PER_1M_TOKENS=
OPENAI_EMBEDDING_USD_PER_1M_TOKENS=

# Password-account email verification and recovery.
# Set AUTH_MAILER_MODE=log for local development or configure Resend in staging/production.
REQUIRE_EMAIL_VERIFICATION=false
AUTH_COOKIE_SAME_SITE=lax
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false
AUTH_MAILER_MODE=
AUTH_EMAIL_FROM=
RESEND_API_KEY=

# Background processing / refresh cadence
BACKGROUND_WORKER_COUNT=5
JOB_POLL_INTERVAL_MINUTES=30
RECOMMENDATION_REFRESH_INTERVAL_MINUTES=60

# Hosting platforms such as Railway inject PORT automatically. Leave this blank
# locally unless you want to override API_ADDR.
PORT=

# Optional supplemental Google Jobs discovery through SerpApi. This is not a
# direct LinkedIn/Indeed crawler; results are treated as lower-priority
# discovery records and deduplicated behind employer-direct ATS postings.
SERPAPI_GOOGLE_JOBS_ENABLED=false
SERPAPI_API_KEY=
SERPAPI_GOOGLE_JOBS_MAX_PAGES=5
SERPAPI_GOOGLE_JOBS_BASE_URL=https://serpapi.com/search.json
