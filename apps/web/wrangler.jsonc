{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "applyforge-web",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none"
  },
  "env": {
    "staging": {
      "name": "applyforge-web-staging"
    }
  }
}
